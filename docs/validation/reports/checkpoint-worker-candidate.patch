+#[cfg(target_os = "linux")]
+#[test]
+#[ignore = "isolated repeated checkpoint synchronization tail child"]
+fn pipeline_repeated_sync_tails_child() {
+    let root = std::path::PathBuf::from(std::env::var_os("GDP_PIPELINE_ROOT").unwrap());
+    let (snapshot, pair, pixels) = fixture();
+    let diagnostics = RawRecordingDiagnostics::with_checkpoint_observation(true);
+    let mut writer = RawRecordingWriter::begin_chunked_with_diagnostics(
+        &root,
+        "repeated",
+        snapshot,
+        1_000_000,
+        diagnostics.clone(),
+    )
+    .unwrap();
+    writer.enable_checkpoint_pipeline().unwrap();
+    // Enabling an already enabled, empty pipeline must not start another worker.
+    writer.enable_checkpoint_pipeline().unwrap();
+    for n in 1..=97 {
+        append(&mut writer, &pair, &pixels, n);
+    }
+    let path = writer.finish().unwrap();
+    let report = diagnostics.report();
+    assert_eq!(report["durable_pairs"], 97);
+    assert_eq!(
+        report["validation_image_bytes"],
+        97 * 2 * (4 + pixels.len())
+    );
+    assert!(report["uncommitted_pairs_peak"].as_u64().unwrap() <= 32);
+    assert!(report["uncommitted_payload_bytes_peak"].as_u64().unwrap() <= 16 * 1024 * 1024);
+    assert_eq!(read_all(&path, false).len(), 97);
+    let events = report["checkpoint_observation"]["events"]
+        .as_array()
+        .unwrap();
+    let tids: std::collections::BTreeSet<_> = events
+        .iter()
+        .filter(|event| event["phase"] == "payload_sync" && event["info"]["asynchronous"] == true)
+        .map(|event| event["tid"].as_u64().unwrap())
+        .collect();
+    assert_eq!(tids.len(), 1);
+    assert!(
+        report["checkpoint_observation"]["stages"]["payload_sync"]["wall"]["samples"]
+            .as_u64()
+            .unwrap()
+            >= 7
+    );
+}
+#[cfg(target_os = "linux")]
+#[test]
+fn repeated_checkpoint_sync_tails_keep_credits_hashes_and_one_worker() {
+    let root = tempfile::tempdir().unwrap();
+    let library = io_faults::compile(root.path());
+    let marker = root.path().join("injected");
+    let mut command = Command::new(std::env::current_exe().unwrap());
+    command
+        .args([
+            "--exact",
+            "pipeline_repeated_sync_tails_child",
+            "--ignored",
+            "--nocapture",
+        ])
+        .env("GDP_PIPELINE_ROOT", root.path())
+        .env("GDP_IO_REPEAT", "1")
+        .env("GDP_IO_DELAY_MS", "40");
+    io_faults::inject(&mut command, &library, "fsync", ".bin", &marker);
+    let output = command.output().unwrap();
+    assert!(
+        output.status.success(),
+        "{}{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+    io_faults::assert_injected(&marker, "fsync");
+}
