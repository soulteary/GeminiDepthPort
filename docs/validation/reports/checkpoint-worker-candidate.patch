+#[cfg(test)]
+mod checkpoint_worker_tests {
+    use super::*;
+    use std::{sync::mpsc, time::Duration};
+
+    fn prefix(count: u64) -> VerifiedPrefix {
+        VerifiedPrefix {
+            imu: ImuProgress::default(),
+            count,
+            index_bytes: count,
+            digest: ring::digest::Context::new(&ring::digest::SHA256),
+            previous: None,
+            position: None,
+        }
+    }
+    fn worker(root: &Path) -> CheckpointWorker {
+        let records = fs::File::create(root.join("records")).unwrap();
+        CheckpointWorker::new(CheckpointFiles::new(&records, root).unwrap()).unwrap()
+    }
+    #[test]
+    fn one_worker_reuses_files_and_bounded_dispatch_never_blocks_append() {
+        let root = tempfile::tempdir().unwrap();
+        let worker = worker(root.path());
+        let (entered_tx, entered) = mpsc::channel();
+        let (release_tx, release) = mpsc::channel();
+        let mut first = worker
+            .dispatch(move |files| {
+                entered_tx
+                    .send((
+                        std::thread::current().id(),
+                        files.records.metadata().unwrap().len(),
+                    ))
+                    .unwrap();
+                release.recv().unwrap();
+                Ok(prefix(1))
+            })
+            .unwrap();
+        let (thread, length) = entered.recv_timeout(Duration::from_secs(2)).unwrap();
+        assert_eq!(length, 0);
+        assert!(!first.is_finished());
+        let (next_tx, next) = mpsc::channel();
+        let second = worker
+            .dispatch(move |files| {
+                next_tx
+                    .send((
+                        std::thread::current().id(),
+                        files.records.metadata().unwrap().len(),
+                    ))
+                    .unwrap();
+                Ok(prefix(2))
+            })
+            .unwrap();
+        assert_eq!(
+            worker.dispatch(|_| Ok(prefix(3))).err().unwrap().code(),
+            "RECORDING_CHECKPOINT_QUEUE_FULL"
+        );
+        release_tx.send(()).unwrap();
+        assert_eq!(first.join().unwrap().count, 1);
+        assert_eq!(second.join().unwrap().count, 2);
+        assert_eq!(
+            next.recv_timeout(Duration::from_secs(2)).unwrap(),
+            (thread, 0)
+        );
+    }
+    #[test]
+    fn error_and_panic_wake_waiters_and_stop_later_dispatch() {
+        for panic in [false, true] {
+            let root = tempfile::tempdir().unwrap();
+            let worker = worker(root.path());
+            let task = worker
+                .dispatch(move |_| {
+                    assert!(!panic, "injected checkpoint panic");
+                    Err(OfflineError::Invalid("INJECTED_CHECKPOINT_IO"))
+                })
+                .unwrap();
+            assert_eq!(
+                task.join().err().unwrap().code(),
+                if panic {
+                    "RECORDING_VERIFIER_PANIC"
+                } else {
+                    "INJECTED_CHECKPOINT_IO"
+                }
+            );
+            let start = std::time::Instant::now();
+            while !worker.thread.as_ref().unwrap().is_finished() {
+                assert!(start.elapsed() < Duration::from_secs(2));
+                std::thread::yield_now();
+            }
+            assert_eq!(
+                worker.dispatch(|_| Ok(prefix(9))).err().unwrap().code(),
+                "RECORDING_CHECKPOINT_WORKER_STOPPED"
+            );
+        }
+    }
+    #[test]
+    fn completed_and_disconnected_results_are_observable_without_blocking() {
+        let (tx, receiver) = mpsc::sync_channel(1);
+        tx.send(Ok(prefix(7))).unwrap();
+        let mut task = CheckpointCompletion {
+            receiver,
+            ready: None,
+        };
+        assert!(task.is_finished());
+        assert!(task.is_finished());
+        assert_eq!(task.join().unwrap().count, 7);
+        let (tx, receiver) = mpsc::sync_channel(1);
+        drop(tx);
+        let mut task = CheckpointCompletion {
+            receiver,
+            ready: None,
+        };
+        assert!(task.is_finished());
+        assert_eq!(
+            task.join().err().unwrap().code(),
+            "RECORDING_VERIFIER_PANIC"
+        );
+        let (tx, receiver) = mpsc::sync_channel(1);
+        drop(tx);
+        let task = CheckpointCompletion {
+            receiver,
+            ready: None,
+        };
+        assert_eq!(
+            task.join().err().unwrap().code(),
+            "RECORDING_VERIFIER_PANIC"
+        );
+    }
+    #[test]
+    fn drop_waits_for_active_and_bounded_pending_work_even_if_results_are_dropped() {
+        let root = tempfile::tempdir().unwrap();
+        let worker = worker(root.path());
+        let (entered_tx, entered) = mpsc::channel();
+        let (release_tx, release) = mpsc::channel();
+        let first = worker
+            .dispatch(move |_| {
+                entered_tx.send(()).unwrap();
+                release.recv().unwrap();
+                Ok(prefix(1))
+            })
+            .unwrap();
+        entered.recv_timeout(Duration::from_secs(2)).unwrap();
+        let (last_tx, last) = mpsc::channel();
+        let second = worker
+            .dispatch(move |_| {
+                last_tx.send(()).unwrap();
+                Ok(prefix(2))
+            })
+            .unwrap();
+        drop(first);
+        drop(second);
+        let (done_tx, done) = mpsc::channel();
+        let dropping = std::thread::spawn(move || {
+            drop(worker);
+            done_tx.send(()).unwrap();
+        });
+        assert!(done.recv_timeout(Duration::from_millis(30)).is_err());
+        release_tx.send(()).unwrap();
+        done.recv_timeout(Duration::from_secs(2)).unwrap();
+        dropping.join().unwrap();
+        last.recv_timeout(Duration::from_secs(2)).unwrap();
+    }
+}
