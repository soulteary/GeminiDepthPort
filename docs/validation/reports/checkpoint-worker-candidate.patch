+type CheckpointWork = Box<dyn FnOnce(&CheckpointFiles) -> Result<VerifiedPrefix> + Send>;
+struct CheckpointJob {
+    work: CheckpointWork,
+    done: SyncSender<Result<VerifiedPrefix>>,
+}
+struct CheckpointCompletion {
+    receiver: Receiver<Result<VerifiedPrefix>>,
+    ready: Option<Result<VerifiedPrefix>>,
+}
+impl CheckpointCompletion {
+    fn is_finished(&mut self) -> bool {
+        if self.ready.is_none() {
+            match self.receiver.try_recv() {
+                Ok(result) => self.ready = Some(result),
+                Err(TryRecvError::Disconnected) => {
+                    self.ready = Some(Err(OfflineError::Invalid("RECORDING_VERIFIER_PANIC")))
+                }
+                Err(TryRecvError::Empty) => return false,
+            }
+        }
+        true
+    }
+    fn join(self) -> Result<VerifiedPrefix> {
+        self.ready.unwrap_or_else(|| {
+            self.receiver
+                .recv()
+                .unwrap_or(Err(OfflineError::Invalid("RECORDING_VERIFIER_PANIC")))
+        })
+    }
+}
+struct CheckpointWorker {
+    sender: Option<SyncSender<CheckpointJob>>,
+    thread: Option<std::thread::JoinHandle<()>>,
+}
+impl CheckpointWorker {
+    fn new(files: CheckpointFiles) -> Result<Self> {
+        // The writer still owns exactly one PendingCheckpoint and the original
+        // 32-pair / 16-MiB credits. This channel never accumulates extra prefixes.
+        let (sender, receiver) = mpsc::sync_channel::<CheckpointJob>(1);
+        let thread = std::thread::Builder::new()
+            .name("recording-checkpoint".into())
+            .spawn(move || {
+                while let Ok(job) = receiver.recv() {
+                    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                        (job.work)(&files)
+                    }))
+                    .unwrap_or(Err(OfflineError::Invalid("RECORDING_VERIFIER_PANIC")));
+                    let failed = result.is_err();
+                    let _ = job.done.send(result);
+                    // Failed recording work is terminal; no later prefix may use
+                    // partially advanced verification or checkpoint state.
+                    if failed {
+                        break;
+                    }
+                }
+            })?;
+        Ok(Self {
+            sender: Some(sender),
+            thread: Some(thread),
+        })
+    }
+    fn dispatch(
+        &self,
+        work: impl FnOnce(&CheckpointFiles) -> Result<VerifiedPrefix> + Send + 'static,
+    ) -> Result<CheckpointCompletion> {
+        let (done, receiver) = mpsc::sync_channel(1);
+        match self.sender.as_ref().unwrap().try_send(CheckpointJob {
+            work: Box::new(work),
+            done,
+        }) {
+            Ok(()) => Ok(CheckpointCompletion {
+                receiver,
+                ready: None,
+            }),
+            Err(TrySendError::Full(_)) => {
+                Err(OfflineError::Invalid("RECORDING_CHECKPOINT_QUEUE_FULL"))
+            }
+            Err(TrySendError::Disconnected(_)) => {
+                Err(OfflineError::Invalid("RECORDING_CHECKPOINT_WORKER_STOPPED"))
+            }
+        }
+    }
+}
+impl Drop for CheckpointWorker {
+    fn drop(&mut self) {
+        self.sender.take();
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+    }
+}
